# TEMPORARY PRE-DEFENSE ONLY.
# Stripe is not the planned Kazakhstan production processor here.
# These variables exist only to demo a sandbox Checkout flow while real local acquiring is pending.
EXPO_PUBLIC_TEMP_PREDEFENSE_STRIPE_SANDBOX_ENABLED=false
EXPO_PUBLIC_TEMP_PREDEFENSE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
TEMP_PREDEFENSE_STRIPE_SANDBOX_SECRET_KEY=sk_test_replace_me

# Needed by native Expo clients because they cannot call a relative /api route.
# For web, the client uses window.location.origin.
EXPO_PUBLIC_TEMP_PREDEFENSE_APP_BASE_URL=http://localhost:8081

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_ENABLE_GEMINI_DIAGNOSTICS=false

{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "$app/*": [
        "./app/*"
      ],
      "$components/*": [
        "./components/*"
      ],
      "$constants/*": [
        "./constants/*"
      ],
      "$contexts/*": [
        "./contexts/*"
      ],
      "$data/*": [
        "./data/*"
      ],
      "$hooks/*": [
        "./hooks/*"
      ],
      "$lib/*": [
        "./lib/*"
      ],
      "$models/*": [
        "./models/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "tmp",
    "tmp/**/*"
  ]
}
